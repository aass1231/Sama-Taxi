import React, { useState, useEffect } from 'react';
import { 
  MapPin, Navigation, Car, Shield, Star, Clock, 
  CreditCard, Search, User, Settings, CheckCircle2, 
  AlertTriangle, Phone, PhoneCall, RefreshCw, Layers
} from 'lucide-react';

export default function App() {
  const [role, setRole] = useState('passenger'); // passenger | captain | admin
  const [passengerState, setPassengerState] = useState('idle'); // idle | searching | assigned | in_trip | completed
  const [pickup, setPickup] = useState({ name: 'بغداد - المنصور', lat: 33.3152, lng: 44.3661 });
  const [destination, setDestination] = useState({ name: 'بغداد - الكرادة', lat: 33.3007, lng: 44.4208 });
  
  // Captain state
  const [isOnline, setIsOnline] = useState(true);
  const [hasSubscription, setHasSubscription] = useState(true);
  const [captainState, setCaptainState] = useState('idle'); // idle | incoming_request | driving_to_passenger | trip_in_progress
  
  // Fare Calculation Settings (IQD)
  const [pricing, setPricing] = useState({
    baseFare: 1500,
    perKm: 500,
    minFare: 3000
  });

  const estimatedDistance = 7.2; // km
  const calculatedFare = Math.max(pricing.minFare, pricing.baseFare + (estimatedDistance * pricing.perKm));

  // Simulated Ride Flow Timers
  useEffect(() => {
    if (passengerState === 'searching') {
      const timer = setTimeout(() => {
        setPassengerState('assigned');
        setCaptainState('driving_to_passenger');
      }, 3000);
      return () => clearTimeout(timer);
    }
  }, [passengerState]);

  return (
    <div className="flex flex-col h-screen bg-slate-900 text-slate-100 font-sans dir-rtl" dir="rtl">
      
      {/* Top Header & Role Switcher */}
      <header className="bg-slate-800 border-b border-slate-700 p-3 flex justify-between items-center z-10 shadow-md">
        <div className="flex items-center space-x-2 space-x-reverse">
          <div className="w-8 h-8 rounded-full bg-cyan-500 flex items-center justify-center text-slate-900 font-bold text-lg shadow-lg shadow-cyan-500/30">
            س
          </div>
          <span className="font-bold text-lg tracking-wide text-cyan-400">سما تكسي</span>
        </div>

        {/* Role Selector Buttons */}
        <div className="flex bg-slate-900 p-1 rounded-lg border border-slate-700 text-xs">
          <button 
            onClick={() => setRole('passenger')}
            className={`px-3 py-1.5 rounded-md transition ${role === 'passenger' ? 'bg-cyan-500 text-slate-900 font-bold' : 'text-slate-400'}`}>
            الراكب
          </button>
          <button 
            onClick={() => setRole('captain')}
            className={`px-3 py-1.5 rounded-md transition ${role === 'captain' ? 'bg-cyan-500 text-slate-900 font-bold' : 'text-slate-400'}`}>
            الكابتن
          </button>
          <button 
            onClick={() => setRole('admin')}
            className={`px-3 py-1.5 rounded-md transition ${role === 'admin' ? 'bg-cyan-500 text-slate-900 font-bold' : 'text-slate-400'}`}>
            الآدمن
          </button>
        </div>
      </header>

      {/* Main Content Area */}
      <div className="flex-1 relative overflow-hidden flex flex-col">

        {/* ---------------- PASSENGER INTERFACE ---------------- */}
        {role === 'passenger' && (
          <div className="flex-1 flex flex-col relative">
            {/* Map Simulation Placeholder */}
            <div className="flex-1 bg-slate-950 relative flex items-center justify-center overflow-hidden">
              <div className="absolute inset-0 opacity-20 bg-[radial-gradient(#38bdf8_1px,transparent_1px)] [background-size:16px_16px]"></div>
              
              <div className="text-center z-0 p-4">
                <Navigation className="w-12 h-12 text-cyan-400 mx-auto animate-bounce mb-2" />
                <p className="text-slate-400 text-sm">الخريطة التفاعلية للعراق</p>
                <p className="text-xs text-slate-500 mt-1">تحديد الموقع التلقائي + الدبوس اليدوي</p>
              </div>

              {/* Status Badge Over Map */}
              {passengerState === 'searching' && (
                <div className="absolute top-4 bg-amber-500/20 border border-amber-500/50 text-amber-300 px-4 py-2 rounded-full text-sm flex items-center gap-2 backdrop-blur-md">
                  <RefreshCw className="w-4 h-4 animate-spin" /> جاري البحث عن كابتن قريب...
                </div>
              )}
              {passengerState === 'assigned' && (
                <div className="absolute top-4 bg-emerald-500/20 border border-emerald-500/50 text-emerald-300 px-4 py-2 rounded-full text-sm flex items-center gap-2 backdrop-blur-md">
                  <CheckCircle2 className="w-4 h-4" /> الكابتن علي بالطريق إليك (3 دقائق)
                </div>
              )}
            </div>

            {/* Bottom Interactive Sheet */}
            <div className="bg-slate-800 rounded-t-2xl border-t border-slate-700 p-4 shadow-2xl z-10">
              {passengerState === 'idle' && (
                <div className="space-y-3">
                  <h3 className="font-bold text-slate-200">وين تريد تروح اليوم؟</h3>
                  
                  {/* Pickup & Destination Inputs */}
                  <div className="space-y-2">
                    <div className="flex items-center bg-slate-900 border border-slate-700 rounded-lg p-2.5">
                      <MapPin className="w-5 h-5 text-cyan-400 ml-2" />
                      <input 
                        type="text" 
                        value={pickup.name} 
                        onChange={(e) => setPickup({ ...pickup, name: e.target.value })}
                        className="bg-transparent text-sm text-slate-100 flex-1 outline-none" 
                        placeholder="موقع الاستلام" 
                      />
                    </div>
                    <div className="flex items-center bg-slate-900 border border-slate-700 rounded-lg p-2.5">
                      <Navigation className="w-5 h-5 text-emerald-400 ml-2" />
                      <input 
                        type="text" 
                        value={destination.name} 
                        onChange={(e) => setDestination({ ...destination, name: e.target.value })}
                        className="bg-transparent text-sm text-slate-100 flex-1 outline-none" 
                        placeholder="وجهة الوصول" 
                      />
                    </div>
                  </div>

                  {/* Fare Estimate */}
                  <div className="flex justify-between items-center bg-slate-900/50 p-3 rounded-lg border border-slate-700/50 text-sm">
                    <span className="text-slate-400">التكلفة التقديرية:</span>
                    <span className="font-bold text-cyan-400 text-base">{calculatedFare.toLocaleString()} د.ع</span>
                  </div>

                  {/* Request Button */}
                  <button 
                    onClick={() => setPassengerState('searching')}
                    className="w-full bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-bold py-3 rounded-xl transition shadow-lg shadow-cyan-500/20">
                    طلب سما تكسي الآن
                  </button>
                </div>
              )}

              {passengerState === 'searching' && (
                <div className="text-center py-6 space-y-3">
                  <div className="w-12 h-12 border-4 border-cyan-500 border-t-transparent rounded-full animate-spin mx-auto"></div>
                  <p className="font-bold text-slate-200">جاري الاتصال بالكباتن القريبين...</p>
                  <button 
                    onClick={() => setPassengerState('idle')}
                    className="text-rose-400 text-sm hover:underline">
                    إلغاء الطلب
                  </button>
                </div>
              )}

              {passengerState === 'assigned' && (
                <div className="space-y-4">
                  <div className="flex justify-between items-center">
                    <div className="flex items-center gap-3">
                      <div className="w-12 h-12 rounded-full bg-slate-700 flex items-center justify-center text-xl font-bold border border-slate-600">
                        👨‍✈️
                      </div>
                      <div>
                        <h4 className="font-bold text-slate-100">الكابتن علي حسين</h4>
                        <p className="text-xs text-slate-400">سياحية - سايبا بيضاء (بغداد 12345)</p>
                      </div>
                    </div>
                    <div className="text-left">
                      <span className="text-xs bg-cyan-500/10 text-cyan-400 px-2.5 py-1 rounded-full border border-cyan-500/30">★ 4.9</span>
                    </div>
                  </div>

                  <div className="flex gap-2">
                    <button className="flex-1 bg-slate-700 hover:bg-slate-600 py-2.5 rounded-lg text-sm font-semibold flex items-center justify-center gap-2">
                      <PhoneCall className="w-4 h-4 text-emerald-400" /> اتصال
                    </button>
                    <button 
                      onClick={() => { setPassengerState('idle'); setCaptainState('idle'); }}
                      className="bg-rose-500/10 hover:bg-rose-500/20 text-rose-400 border border-rose-500/30 px-4 py-2.5 rounded-lg text-sm">
                      إلغاء
                    </button>
                  </div>
                </div>
              )}
            </div>
          </div>
        )}

        {/* ---------------- CAPTAIN INTERFACE ---------------- */}
        {role === 'captain' && (
          <div className="flex-1 p-4 flex flex-col justify-between bg-slate-900">
            {/* Subscription Warning Status */}
            {!hasSubscription ? (
              <div className="bg-rose-500/10 border border-rose-500/30 p-4 rounded-xl text-center space-y-3">
                <AlertTriangle className="w-8 h-8 text-rose-400 mx-auto" />
                <h3 className="font-bold text-rose-300">اشتراكك الشهري منتهي!</h3>
                <p className="text-xs text-slate-400">يرجى تجديد الاشتراك الشهري بقيمة 10,000 د.ع لاستلام الطلبات.</p>
                <button 
                  onClick={() => setHasSubscription(true)}
                  className="bg-rose-500 text-white font-bold px-4 py-2 rounded-lg text-sm w-full">
                  تفعيل الاشتراك الان (تجريبي)
                </button>
              </div>
            ) : (
              <div className="space-y-4">
                {/* Online Switch */}
                <div className="bg-slate-800 p-4 rounded-xl border border-slate-700 flex justify-between items-center">
                  <div>
                    <p className="font-bold text-slate-200">حالة الكابتن</p>
                    <p className="text-xs text-slate-400">{isOnline ? 'جاهز لاستقبال الطلبات' : 'غير متصل'}</p>
                  </div>
                  <button 
                    onClick={() => setIsOnline(!isOnline)}
                    className={`px-4 py-2 rounded-lg font-bold text-sm transition ${isOnline ? 'bg-emerald-500 text-slate-950' : 'bg-slate-700 text-slate-300'}`}>
                    {isOnline ? 'متصل' : 'دخول'}
                  </button>
                </div>

                {/* Ride Request Card */}
                {captainState === 'driving_to_passenger' ? (
                  <div className="bg-slate-800 p-4 rounded-xl border border-cyan-500/40 space-y-3">
                    <div className="flex justify-between items-center text-xs text-cyan-400">
                      <span>طلب جديد متوافق</span>
                      <span>{calculatedFare.toLocaleString()} د.ع</span>
                    </div>
                    <div>
                      <p className="text-xs text-slate-400">من:</p>
                      <p className="text-sm font-semibold text-slate-200">{pickup.name}</p>
                    </div>
                    <div>
                      <p className="text-xs text-slate-400">إلى:</p>
                      <p className="text-sm font-semibold text-slate-200">{destination.name}</p>
                    </div>
                    <button 
                      onClick={() => setCaptainState('trip_in_progress')}
                      className="w-full bg-emerald-500 text-slate-950 font-bold py-2.5 rounded-lg text-sm">
                      بدء الرحلة الآن
                    </button>
                  </div>
                ) : captainState === 'trip_in_progress' ? (
                  <div className="bg-slate-800 p-4 rounded-xl border border-emerald-500/40 text-center space-y-3">
                    <p className="text-emerald-400 font-bold text-sm">الرحلة جارية حالياً 🚕</p>
                    <p className="text-slate-300 text-xs">الوجهة: {destination.name}</p>
                    <button 
                      onClick={() => { setCaptainState('idle'); setPassengerState('idle'); }}
                      className="w-full bg-cyan-500 text-slate-950 font-bold py-2.5 rounded-lg text-sm">
                      إنهاء الرحلة وتحصيل المبلغ ({calculatedFare.toLocaleString()} د.ع)
                    </button>
                  </div>
                ) : (
                  <div className="text-center py-12 text-slate-500 text-sm">
                    بانتظار طلبات الراكبين القريبة...
                  </div>
                )}
              </div>
            )}
          </div>
        )}

        {/* ---------------- ADMIN DASHBOARD ---------------- */}
        {role === 'admin' && (
          <div className="flex-1 p-4 space-y-4 overflow-y-auto bg-slate-900 text-sm">
            <h2 className="font-bold text-base text-cyan-400">لوحة التحكم والأدمن</h2>

            {/* Config Box */}
            <div className="bg-slate-800 p-4 rounded-xl border border-slate-700 space-y-3">
              <h3 className="font-semibold text-slate-200 text-xs">إعدادات التسعيرة (دينار عراقي)</h3>
              
              <div className="grid grid-cols-2 gap-2">
                <div>
                  <label className="text-xs text-slate-400 block mb-1">الافتححية (Base)</label>
                  <input 
                    type="number" 
                    value={pricing.baseFare} 
                    onChange={(e) => setPricing({...pricing, baseFare: Number(e.target.value)})}
                    className="w-full bg-slate-900 border border-slate-700 rounded p-2 text-slate-100"
                  />
                </div>
                <div>
                  <label className="text-xs text-slate-400 block mb-1">سعر الكيلومتر</label>
                  <input 
                    type="number" 
                    value={pricing.perKm} 
                    onChange={(e) => setPricing({...pricing, perKm: Number(e.target.value)})}
                    className="w-full bg-slate-900 border border-slate-700 rounded p-2 text-slate-100"
                  />
                </div>
              </div>
            </div>

            {/* Quick Stats */}
            <div className="grid grid-cols-2 gap-2">
              <div className="bg-slate-800 p-3 rounded-xl border border-slate-700 text-center">
                <p className="text-xs text-slate-400">الكباتن المعتمدين</p>
                <p className="text-xl font-bold text-cyan-400 mt-1">142</p>
              </div>
              <div className="bg-slate-800 p-3 rounded-xl border border-slate-700 text-center">
                <p className="text-xs text-slate-400">الاشتراكات الفعالة</p>
                <p className="text-xl font-bold text-emerald-400 mt-1">118</p>
              </div>
            </div>
          </div>
        )}

      </div>
    </div>
  );
}
